# Copy to .env and fill in. Never commit real keys.
AUTOPILOT_API_KEY=change-me-to-something-long
AUTOPILOT_DB=                       # default: app/autopilot.db (sqlite)
AUTOPILOT_RATE_LIMIT=120            # requests per minute per api key
AUTOPILOT_EDGES=                    # "host,region" lines for the probe job
